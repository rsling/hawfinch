# Data: kept out of git. Only READMEs, placeholders and release manifests are tracked.
/data/raw/*
/data/interim/*
/data/release/*/*
!/data/release/*/MANIFEST.json
/analysis/output/*
!.gitkeep

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# R
.Rhistory
.RData
.Rproj.user/
renv/library/

# macOS
.DS_Store
